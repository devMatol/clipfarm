# Copie ce fichier en .env et adapte. Rien ici n'est payant.

# Dossier ou sont stockes projets, clips, caches
CLIPFARM_DATA_DIR=./data
CLIPFARM_LANGUAGE=fr

# Transcription (GPU NVIDIA). Sans GPU : WHISPER_DEVICE=cpu et WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
# 1 = separe la voix du son du jeu avec Demucs avant de transcrire
ISOLATE_VOICE=1
# Jeton Hugging Face (gratuit, lecture seule) pour distinguer les voix (diarisation). Optionnel.
HF_TOKEN=

# Choix des meilleurs moments : ollama (local, gratuit), gemini (palier gratuit, donnees utilisees par Google), none
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Contraintes des clips
MIN_CLIP_S=30
MAX_CLIP_S=70
MAX_CLIPS=8

# Phase 2 : base de donnees (docker compose up -d)
DATABASE_URL=postgresql://clipfarm:clipfarm@localhost:5432/clipfarm

# Phase 3 : front
NEXT_PUBLIC_API_URL=http://localhost:8000
